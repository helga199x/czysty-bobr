---
import '../styles/global.css';
import { siteConfig, type LocaleCode } from '../config/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { businessConfig } from '../config/business';
import type { LocaleMessages } from '../config/locales';
import { withBase } from '../config/paths';
import { catalogConfig } from '../config/catalog';

interface Props {
  locale: LocaleCode;
  messages: LocaleMessages;
  canonicalPath: string;
  pageKind?: 'home' | 'pricing';
}

const { locale, messages, canonicalPath, pageKind = 'home' } = Astro.props;
const canonicalUrl = Astro.site ? new URL(withBase(canonicalPath), Astro.site).toString() : undefined;
const alternateLocales = siteConfig.locales.map((code) => ({
  code,
  href: pageKind === 'pricing'
    ? code === siteConfig.defaultLocale ? '/cennik/' : `/${code}/pricing/`
    : code === siteConfig.defaultLocale ? '/' : `/${code}/`,
}));
const titleSuffix = pageKind === 'pricing' ? messages.pricing.seo_title_suffix : messages.seo.title_suffix;
const description = pageKind === 'pricing' ? messages.pricing.seo_description : messages.seo.description;
const title = `${businessConfig.brand} | ${titleSuffix}`;
const defaultPath = pageKind === 'pricing' ? '/cennik/' : '/';
const homeUrl = Astro.site ? new URL(withBase('/'), Astro.site).toString() : undefined;
const imageUrl = Astro.site ? new URL(withBase('/logo.jpeg'), Astro.site).toString() : undefined;
const contact = businessConfig.contact;
const hasValue = (value: string) => Boolean(value.trim()) && !value.startsWith('ADD_');
const businessSchema = homeUrl ? {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${homeUrl}#business`,
  name: businessConfig.brand,
  url: homeUrl,
  image: imageUrl,
  logo: imageUrl,
  ...(hasValue(contact.phone) ? { telephone: contact.phone } : {}),
  ...(hasValue(contact.email) ? { email: contact.email } : {}),
  ...(catalogConfig.travel.city ? {
    areaServed: { '@type': 'City', name: catalogConfig.travel.city },
  } : {}),
  ...(contact.working_days.length && contact.working_hours.start && contact.working_hours.end ? {
    openingHoursSpecification: [{
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: contact.working_days.map((day) => `https://schema.org/${day.charAt(0).toUpperCase()}${day.slice(1)}`),
      opens: contact.working_hours.start,
      closes: contact.working_hours.end,
    }],
  } : {}),
} : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080c10" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={businessConfig.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={messages.seo.og_locale} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {imageUrl && <>
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={businessConfig.brand} />
    </>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image:alt" content={businessConfig.brand} />}
    {Astro.site && alternateLocales.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={Astro.site ? new URL(withBase(href), Astro.site).toString() : withBase(href)} />
    ))}
    {Astro.site && <link rel="alternate" hreflang="x-default" href={new URL(withBase(defaultPath), Astro.site).toString()} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {businessSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <SiteHeader locale={locale} messages={messages} pageKind={pageKind} />
    <main>
      <slot />
    </main>
    <SiteFooter messages={messages} />
  </body>
</html>
