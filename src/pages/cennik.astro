---
import SiteLayout from '../layouts/SiteLayout.astro';
import PricingPage from '../components/PricingPage.astro';
import { getTranslations } from '../config/locales';
import { siteConfig } from '../config/site';

const locale = siteConfig.defaultLocale;
const messages = getTranslations(locale);
---

<SiteLayout locale={locale} messages={messages} canonicalPath="/cennik/" pageKind="pricing">
  <PricingPage messages={messages} />
</SiteLayout>