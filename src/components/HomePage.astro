---
import Hero from './Hero.astro';
import Services from './Services.astro';
import Pricing from './Pricing.astro';
import Results from './Results.astro';
import Contact from './Contact.astro';
import type { LocaleMessages } from '../config/locales';

interface Props {
  locale: import('../config/site').LocaleCode;
  messages: LocaleMessages;
}

const { locale, messages } = Astro.props;
---

<Hero messages={messages} />
<Services messages={messages} />
<Pricing locale={locale} messages={messages} />
<Results messages={messages} />
<Contact messages={messages} />
