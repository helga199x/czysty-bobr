---
import { siteConfig, type LocaleCode } from '../config/site';
import { businessConfig } from '../config/business';
import type { LocaleMessages } from '../config/locales';
import { withBase } from '../config/paths';

interface Props {
  locale: LocaleCode;
  messages: LocaleMessages;
  pageKind: 'home' | 'pricing';
}

const { locale, messages, pageKind } = Astro.props;
const locales = siteConfig.locales;
const [brandLead, ...brandRest] = businessConfig.brand.split(' ');
const showEffectsLink = businessConfig.features.effects || businessConfig.features.beforeAfterGallery;
const localeHref = (code: LocaleCode) => withBase(code === 'pl' ? '/' : `/${code}/`);
const pricingHref = (code: LocaleCode) => withBase(code === 'pl' ? '/cennik/' : `/${code}/pricing/`);
const languageHref = (code: LocaleCode) => pageKind === 'pricing' ? pricingHref(code) : localeHref(code);
const homeSectionHref = (id: string) => pageKind === 'home' ? `#${id}` : `${localeHref(locale)}#${id}`;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localeHref(locale)} aria-label={`${businessConfig.brand} — ${messages.site.home_label}`}>
      {brandLead} <span>{brandRest.join(' ')}</span>
    </a>
    <nav class="desktop-nav" aria-label={messages.navigation.label}>
      <a href={homeSectionHref('uslugi')}>{messages.navigation.services}</a>
      <a href={pricingHref(locale)} aria-current={pageKind === 'pricing' ? 'page' : undefined}>{messages.navigation.pricing}</a>
      {showEffectsLink && <a href={homeSectionHref('efekty')}>{messages.navigation.results}</a>}
      <a href={homeSectionHref('kontakt')}>{messages.navigation.contact}</a>
    </nav>
    <div class="header-actions">
      <nav class="language-nav" aria-label={messages.navigation.languages}>
        {locales.map((code) => (
          <a
            href={languageHref(code)}
            lang={code}
            aria-current={locale === code ? 'page' : undefined}
            aria-label={messages.languages[code]}
          >
            {code.toUpperCase()}
          </a>
        ))}
      </nav>
      <a class="button button-small" href={homeSectionHref('cennik')}>{messages.navigation.quote}</a>
    </div>
    <details class="mobile-menu">
      <summary aria-label={messages.navigation.open_menu}><span></span><span></span><span></span></summary>
      <nav aria-label={messages.navigation.label}>
        <a href={homeSectionHref('uslugi')}>{messages.navigation.services}</a>
        <a href={pricingHref(locale)} aria-current={pageKind === 'pricing' ? 'page' : undefined}>{messages.navigation.pricing}</a>
        {showEffectsLink && <a href={homeSectionHref('efekty')}>{messages.navigation.results}</a>}
        <a href={homeSectionHref('kontakt')}>{messages.navigation.contact}</a>
      </nav>
    </details>
  </div>
</header>
