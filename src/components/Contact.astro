---
import { businessConfig } from '../config/business';
import type { LocaleMessages } from '../config/locales';

interface Props {
  messages: LocaleMessages;
}

const { messages } = Astro.props;
const contact = businessConfig.contact;
const phoneHref = contact.phone ? `tel:${contact.phone.replace(/[^\d+]/g, '')}` : undefined;
const whatsappNumber = contact.whatsapp.replace(/\D/g, '');
const whatsappHref = whatsappNumber ? `https://wa.me/${whatsappNumber}` : undefined;
---

<section class="contact-callout" aria-labelledby="callout-title">
  <div class="container callout-inner">
    <div>
      <h2 id="callout-title">{messages.callout.title}</h2>
      <p>{messages.callout.description}</p>
    </div>
    <a class="button button-light" href="#kontakt">{messages.callout.action}<span aria-hidden="true">→</span></a>
  </div>
</section>

<section id="kontakt" class="content-section contact-section" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-intro">
      <p class="eyebrow">{messages.contact.eyebrow}</p>
      <h2 id="contact-title">{messages.contact.title}</h2>
      <p>{messages.contact.description}</p>
    </div>
    <div class="contact-methods">
      <article class="contact-method">
        <h3>{messages.contact.phone}</h3>
        {phoneHref ? <a href={phoneHref}>{contact.phone}</a> : <p>{messages.contact.not_provided}</p>}
      </article>
      <article class="contact-method">
        <h3>{messages.contact.whatsapp}</h3>
        {whatsappHref
          ? <a href={whatsappHref} target="_blank" rel="noopener noreferrer">{contact.whatsapp}</a>
          : <p>{messages.contact.not_provided}</p>}
      </article>
      <article class="contact-method">
        <h3>{messages.contact.email}</h3>
        {contact.email
          ? <a href={`mailto:${contact.email}`}>{contact.email}</a>
          : <p>{messages.contact.not_provided}</p>}
      </article>
      <article class="contact-method contact-hours">
        <h3>{messages.contact.working_hours}</h3>
        <dl>
          <div><dt>{messages.contact.monday_friday}</dt><dd>{contact.working_hours.monday_friday || messages.contact.not_provided}</dd></div>
          <div><dt>{messages.contact.saturday}</dt><dd>{contact.working_hours.saturday || messages.contact.not_provided}</dd></div>
          <div><dt>{messages.contact.sunday}</dt><dd>{contact.working_hours.sunday || messages.contact.not_provided}</dd></div>
        </dl>
      </article>
    </div>
  </div>
</section>
